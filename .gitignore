# --- PyInstaller output ------------------------------------------------
# These are large and fully rebuildable from tools/n2o_injector.spec.
# dist/ is ~600 MB and the one-file exe alone is 156 MB, which exceeds
# GitHub's 100 MB per-file hard limit -- committing it would break the push.
build/
dist/
*.spec.bak

# --- generated documents -----------------------------------------------
# Rebuild with: python tools/build_docx.py
#
# The .docx are tracked deliberately despite being generated: the README links
# to them directly, so ignoring them leaves two dead links on the repository
# front page for anyone who does not clone and run the build. They are ~50 KB
# each. The PDFs are 10x that and nothing links to them, so they stay out.
USER_GUIDE.pdf
VALIDATION.pdf

# Raster previews of drawings that are already tracked as vector PDFs --
# the PNG is 12x the size and carries no extra information.
Trade Study/*.png

# --- generated run artefacts -------------------------------------------
examples/output/
startup_error.log
self_test.log
*.eng
*.rse

# --- python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- editors / OS ------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
